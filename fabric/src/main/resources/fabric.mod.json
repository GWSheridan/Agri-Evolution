{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "Start with Wild Wheat, breed new crops, and build up to automated irrigation and greenhouses.",
  "authors": ["GWSHERIDAN"],
  "contact": {"sources": "https://github.com/GWSheridan/Agri-Evolution"},
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": ["com.agrievolution.fabric.AgriEvolutionFabric"],
    "client": ["com.agrievolution.fabric.FabricClient"],
    "jei_mod_plugin": ["com.agrievolution.client.jei.AgriJeiPlugin"]
  },
  "accessWidener": "agri_evolution.accesswidener",
  "mixins": ["agri_evolution.fabric.mixins.json"],
  "depends": {
    "java": ">=21",
    "minecraft": "${minecraft_version}",
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}"
  }
}
